        private const int EndRow = 32;

        /// <summary>
        /// Parses the Department FTE Summary section from the given DataTable (sheet).
        /// </summary>
        public static DepartmentFTESummary Parse(DataTable sheet)
        {
            var rows = ExcelRowExtractor.ExtractRows(sheet, StartRow, EndRow);
            return MapToModel(rows);
        }

        /// <summary>
        /// Maps the 16 extracted rows to the DepartmentFTESummary model.
        /// Rows come in P1/P2 pairs:
        ///   [0]  Row 18 → P1 Employed (Productive) FTEs
        ///   [1]  Row 19 → P2 Employed (Productive) FTEs
        ///   [2]  Row 20 → P1 Contract Labor %
        ///   [3]  Row 21 → P2 Contract Labor %
