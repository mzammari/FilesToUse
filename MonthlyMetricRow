    #region Main Parser (Entry Point)

    /// <summary>
    /// Main parser that opens the Excel file once and parses all three sections.
    /// </summary>
    public class MonthlyDeptDetailExcelParser
    {
        /// <summary>
        /// Parses all three sections from the Monthly Department Detail Comparison Report.
        /// Opens the Excel file once and passes the DataTable to each section parser.
        /// </summary>
        public static (DepartmentFTESummary FTESummary,
                        DepartmentLaborExpenseSummary LaborExpenseSummary,
                        DepartmentVolumeSummary VolumeSummary)
            ParseAll(string filePath)
        {
            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);

            using (var stream = File.Open(filePath, FileMode.Open, FileAccess.Read))
            using (var reader = ExcelReaderFactory.CreateReader(stream))
            {
                var dataSet = reader.AsDataSet();
                var sheet = dataSet.Tables[0];

                var fteSummary = DepartmentFTESummaryParser.Parse(sheet);
                var laborExpenseSummary = DepartmentLaborExpenseSummaryParser.Parse(sheet);
                var volumeSummary = DepartmentVolumeSummaryParser.Parse(sheet);

                return (fteSummary, laborExpenseSummary, volumeSummary);
            }
        }
    }

