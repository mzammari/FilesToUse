    #region Shared Parser Helpers

    /// <summary>
    /// Shared helper methods for extracting row data from the Excel sheet.
    /// Because columns are scattered (with hidden columns in between), the parser
    /// iterates through each cell in the row and collects only non-empty values.
    /// Each data row consistently has exactly 14 non-empty cells:
    ///   [0] = Description (e.g., "P1 - Employed (Productive) FTEs")
    ///   [1]-[12] = Jan through Dec values
    ///   [13] = Total
    /// 
    /// Section positions are detected dynamically by searching for section header text,
    /// then scanning forward for consecutive rows starting with "P1 - " or "P2 - ".
    /// This handles Excel files where row positions shift across different facilities.
    /// </summary>
    public static class ExcelRowExtractor
    {
        /// <summary>
        /// Iterates through each cell in the given row and collects non-empty values.
        /// Expects exactly 14 non-empty cells: Description + 12 months + Total.
        /// </summary>
        public static MonthlyMetricRow ExtractRowValues(DataTable sheet, int rowIdx)
        {
            var row = sheet.Rows[rowIdx];
            var nonEmptyValues = new List<string>();

            for (int colIdx = 0; colIdx < sheet.Columns.Count; colIdx++)
            {
                var cellValue = row[colIdx];

                if (cellValue == null || cellValue == DBNull.Value)
                    continue;

                string strValue = cellValue.ToString().Trim();

                if (string.IsNullOrEmpty(strValue))
                    continue;

                nonEmptyValues.Add(strValue);
            }

            // We expect exactly 14 non-empty values per row
            if (nonEmptyValues.Count < 14)
                return null;

            return new MonthlyMetricRow
            {
                Description = nonEmptyValues[0],
                Jan = ParseAndRound(nonEmptyValues[1]),
                Feb = ParseAndRound(nonEmptyValues[2]),
                Mar = ParseAndRound(nonEmptyValues[3]),
                Apr = ParseAndRound(nonEmptyValues[4]),
                May = ParseAndRound(nonEmptyValues[5]),
                Jun = ParseAndRound(nonEmptyValues[6]),
                Jul = ParseAndRound(nonEmptyValues[7]),
                Aug = ParseAndRound(nonEmptyValues[8]),
                Sep = ParseAndRound(nonEmptyValues[9]),
                Oct = ParseAndRound(nonEmptyValues[10]),
                Nov = ParseAndRound(nonEmptyValues[11]),
                Dec = ParseAndRound(nonEmptyValues[12]),
                Total = ParseAndRound(nonEmptyValues[13])
            };
        }

        /// <summary>
        /// Finds the section header row by searching for the exact text in any cell.
        /// Returns the 0-indexed row number, or -1 if not found.
        /// </summary>
        public static int FindSectionHeaderRow(DataTable sheet, string sectionHeaderText)
        {
            for (int rowIdx = 0; rowIdx < sheet.Rows.Count; rowIdx++)
            {
                var row = sheet.Rows[rowIdx];
                for (int colIdx = 0; colIdx < sheet.Columns.Count; colIdx++)
                {
                    var cellValue = row[colIdx];
                    if (cellValue == null || cellValue == DBNull.Value)
                        continue;

                    string strValue = cellValue.ToString().Trim();
                    if (strValue.Equals(sectionHeaderText, StringComparison.OrdinalIgnoreCase))
                        return rowIdx;
                }
            }
            return -1;
        }

        /// <summary>
        /// Starting from a section header row, scans forward to find the first row
        /// that starts with "P1 - " or "P2 - ", then collects all consecutive
        /// P1/P2 data rows.
        /// </summary>
        public static List<MonthlyMetricRow> ExtractSectionRows(DataTable sheet, string sectionHeaderText)
        {
            int headerRow = FindSectionHeaderRow(sheet, sectionHeaderText);
            if (headerRow < 0)
                throw new InvalidOperationException(
                    $"Section header '{sectionHeaderText}' not found in the Excel sheet.");

            // Scan forward from the header to find the first P1/P2 data row
            int firstDataRow = -1;
            for (int rowIdx = headerRow + 1; rowIdx < sheet.Rows.Count; rowIdx++)
            {
                if (IsP1OrP2Row(sheet, rowIdx))
                {
                    firstDataRow = rowIdx;
                    break;
                }
            }

            if (firstDataRow < 0)
                throw new InvalidOperationException(
                    $"No P1/P2 data rows found after section header '{sectionHeaderText}'.");

            // Collect all consecutive P1/P2 data rows
            var extractedRows = new List<MonthlyMetricRow>();
            for (int rowIdx = firstDataRow; rowIdx < sheet.Rows.Count; rowIdx++)
            {
                if (!IsP1OrP2Row(sheet, rowIdx))
                    break;

                var metricRow = ExtractRowValues(sheet, rowIdx);
                if (metricRow != null)
                {
                    extractedRows.Add(metricRow);
                }
            }

            return extractedRows;
        }

        /// <summary>
        /// Checks if any cell in the given row starts with "P1 - " or "P2 - ".
        /// </summary>
        private static bool IsP1OrP2Row(DataTable sheet, int rowIdx)
        {
            var row = sheet.Rows[rowIdx];
            for (int colIdx = 0; colIdx < sheet.Columns.Count; colIdx++)
            {
                var cellValue = row[colIdx];
                if (cellValue == null || cellValue == DBNull.Value)
                    continue;

                string strValue = cellValue.ToString().Trim();
                if (strValue.StartsWith("P1 - ") || strValue.StartsWith("P2 - "))
                    return true;
            }
            return false;
        }

        /// <summary>
        /// Parses a string value to double and rounds to 2 decimal places.
        /// Returns 0.0 if parsing fails.
        /// </summary>
        public static double ParseAndRound(string value)
        {
            if (double.TryParse(value, out double result))
            {
                return Math.Round(result, 2);
            }
            return 0.0;
        }
    }

