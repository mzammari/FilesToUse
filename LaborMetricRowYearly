    /// <summary>Maps the first row of a result set. Returns null if there are no rows.</summary>
    public static LaborMetricRow? FromDataTable(DataTable table)
        => table.Rows.Count == 0 ? null : FromDataRow(table.Rows[0]);

    /// <summary>Maps every row of a result set (e.g. one row per department/facility).</summary>
    public static IReadOnlyList<LaborMetricRow> FromDataTableAll(DataTable table)
    {
        var list = new List<LaborMetricRow>(table.Rows.Count);
        foreach (DataRow row in table.Rows)
            list.Add(FromDataRow(row));
        return list;
    }

