using ClosedXML.Excel;
using System;
using System.Collections.Generic;
using System.Linq;

namespace ISAS.Automation
{
    /// <summary>
    /// Represents a discovered column header with its position metadata.
    /// </summary>
    public class ColumnInfo
    {
        public string HeaderName { get; set; }
        public int ColumnIndex { get; set; }       // 1-based (ClosedXML convention)
        public string ColumnLetter { get; set; }    // "A", "B", ... "AA", etc.
        public int HeaderRow { get; set; }           // Which row the header was found in
        public bool IsHidden { get; set; }           // Whether the column is hidden in Excel

        public override string ToString()
            => $"{ColumnLetter} (Col {ColumnIndex}){(IsHidden ? " [HIDDEN]" : "")} -> \"{HeaderName}\" [Row {HeaderRow}]";
    }

    /// <summary>
    /// Auto-discovers column headers from an Excel worksheet without hardcoding positions.
    /// </summary>
    public static class ExcelHeaderDiscovery
    {
        /// <summary>
        /// Scans a worksheet and returns a dictionary of header name -> ColumnInfo.
        /// Keys are normalized to uppercase/trimmed for easy lookup.
        /// </summary>
        /// <param name="filePath">Path to the Excel file.</param>
        /// <param name="sheetName">Sheet name (null = first sheet).</param>
        /// <param name="headerRow">Row number to scan (0 = auto-detect first non-empty row).</param>
        /// <param name="normalize">If true, dictionary keys are upper-cased and trimmed.</param>
        public static Dictionary<string, ColumnInfo> GetHeaders(
            string filePath,
            string sheetName = null,
            int headerRow = 0,
            bool normalize = true)
        {
            using var workbook = new XLWorkbook(filePath);
            var worksheet = sheetName != null
                ? workbook.Worksheet(sheetName)
                : workbook.Worksheets.First();

            return GetHeaders(worksheet, headerRow, normalize);
        }

        /// <summary>
        /// Scans a worksheet and returns a dictionary of header name -> ColumnInfo.
        /// Hidden columns are skipped by default.
        /// </summary>
        public static Dictionary<string, ColumnInfo> GetHeaders(
            IXLWorksheet worksheet,
            int headerRow = 0,
            bool normalize = true,
            bool skipHidden = true)
        {
            // Auto-detect header row if not specified
            if (headerRow <= 0)
                headerRow = DetectHeaderRow(worksheet);

            var headers = new Dictionary<string, ColumnInfo>(
                normalize ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal);

            var row = worksheet.Row(headerRow);
            int lastCol = worksheet.LastColumnUsed()?.ColumnNumber() ?? 0;

            for (int col = 1; col <= lastCol; col++)
            {
                bool isHidden = worksheet.Column(col).IsHidden;

                // Skip hidden columns if requested
                if (skipHidden && isHidden)
                    continue;

                var cell = row.Cell(col);
                var value = cell.GetString()?.Trim();

                if (string.IsNullOrWhiteSpace(value))
                    continue;

                string key = normalize ? value.ToUpperInvariant().Trim() : value;

                // Handle duplicate headers by appending suffix
                string uniqueKey = key;
                int suffix = 2;
                while (headers.ContainsKey(uniqueKey))
                    uniqueKey = $"{key}_{suffix++}";

                headers[uniqueKey] = new ColumnInfo
                {
                    HeaderName = value,
                    ColumnIndex = col,
                    ColumnLetter = ColumnIndexToLetter(col),
                    HeaderRow = headerRow,
                    IsHidden = isHidden
                };
            }

            return headers;
        }

        /// <summary>
        /// Returns a flat list of all discovered column headers (useful for logging/display).
        /// </summary>
        public static List<ColumnInfo> GetHeaderList(
            string filePath,
            string sheetName = null,
            int headerRow = 0)
        {
            return GetHeaders(filePath, sheetName, headerRow).Values.ToList();
        }

        /// <summary>
        /// Auto-detects which row contains headers by finding the first row 
        /// with multiple non-empty cells (heuristic).
        /// </summary>
        private static int DetectHeaderRow(IXLWorksheet worksheet, int maxScanRows = 20)
        {
            for (int row = 1; row <= maxScanRows; row++)
            {
                int nonEmptyCount = 0;
                int lastCol = worksheet.LastColumnUsed()?.ColumnNumber() ?? 0;

                for (int col = 1; col <= lastCol; col++)
                {
                    if (!string.IsNullOrWhiteSpace(worksheet.Cell(row, col).GetString()))
                        nonEmptyCount++;
                }

                // A header row typically has 2+ populated cells
                if (nonEmptyCount >= 2)
                    return row;
            }

            return 1; // Fallback to row 1
        }

        /// <summary>
        /// Converts a 1-based column index to Excel column letter(s).
        /// 1 -> A, 26 -> Z, 27 -> AA, etc.
        /// </summary>
        public static string ColumnIndexToLetter(int columnIndex)
        {
            string result = string.Empty;
            while (columnIndex > 0)
            {
                int remainder = (columnIndex - 1) % 26;
                result = (char)('A' + remainder) + result;
                columnIndex = (columnIndex - 1) / 26;
            }
            return result;
        }

        /// <summary>
        /// Converts an Excel column letter to a 1-based index.
        /// A -> 1, Z -> 26, AA -> 27, etc.
        /// </summary>
        public static int ColumnLetterToIndex(string columnLetter)
        {
            int index = 0;
            foreach (char c in columnLetter.ToUpperInvariant())
                index = index * 26 + (c - 'A' + 1);
            return index;
        }
    }
}
