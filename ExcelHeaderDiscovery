using System;
using System.Collections.Generic;
using System.Data;
using System.IO;
using System.Linq;
using System.Text;
using ExcelDataReader;

namespace ISAS_Regression_Automation
{
    /// <summary>
    /// STAND-IN for your team's ExcelHeaderDiscovery class, so this project runs on its own.
    /// If you drop ExcelParser.cs into the real ISAS project, DELETE this file and use the real one.
    /// </summary>
    public class HeaderInfo
    {
        public string HeaderName { get; set; }
        public int ColumnIndex { get; set; }
        public int HeaderRow { get; set; }
    }

    public static class ExcelHeaderDiscovery
    {
        static ExcelHeaderDiscovery()
        {
            // Required on .NET Core / .NET 5+ to read old .xls files
            Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
        }

        /// <summary>Read one sheet (first sheet if sheetName is null) into a DataTable, no header row.</summary>
        public static DataTable ReadSheet(string fileLocation, string sheetName = null)
        {
            using var stream = File.Open(fileLocation, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
            using var reader = ExcelReaderFactory.CreateReader(stream);
            var ds = reader.AsDataSet(new ExcelDataSetConfiguration
            {
                ConfigureDataTable = _ => new ExcelDataTableConfiguration { UseHeaderRow = false }
            });

            if (sheetName == null) return ds.Tables[0];

            return ds.Tables.Cast<DataTable>()
                       .FirstOrDefault(t => t.TableName.Equals(sheetName, StringComparison.OrdinalIgnoreCase))
                   ?? throw new ArgumentException($"Sheet '{sheetName}' not found.");
        }

        /// <summary>
        /// Find the header row (headerRow if > 0, otherwise the first row with 3+ non-empty cells)
        /// and return its headers keyed by name.
        /// </summary>
        public static Dictionary<string, HeaderInfo> GetHeaders(DataTable table, int headerRow = 0)
        {
            int row = headerRow > 0 ? headerRow : FindHeaderRow(table);
            var headers = new Dictionary<string, HeaderInfo>(StringComparer.OrdinalIgnoreCase);

            for (int col = 0; col < table.Columns.Count; col++)
            {
                string name = table.Rows[row][col]?.ToString()?.Trim();
                if (string.IsNullOrEmpty(name) || headers.ContainsKey(name)) continue;
                headers[name] = new HeaderInfo { HeaderName = name, ColumnIndex = col, HeaderRow = row };
            }
            return headers;
        }

        private static int FindHeaderRow(DataTable table)
        {
            for (int r = 0; r < table.Rows.Count; r++)
            {
                int filled = table.Rows[r].ItemArray.Count(v => !string.IsNullOrWhiteSpace(v?.ToString()));
                if (filled >= 3) return r;
            }
            return 0;
        }
    }
}
