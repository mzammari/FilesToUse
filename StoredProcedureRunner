// ---------------------------------------------------------------------------
// 1) Execute a stored procedure and return its first result set.
// ---------------------------------------------------------------------------
public sealed class StoredProcedureRunner
{
    // Point this at ISAS_WorkloadForecaster. Windows auth keeps a secret out of
    // source; override at runtime with the ISAS_CONN environment variable.
    private const string DefaultConnectionString =
        "Server=YOUR_SERVER;Database=ISAS_WorkloadForecaster;Integrated Security=True;TrustServerCertificate=True;";

    private readonly string _connectionString;

    /// <summary>Uses the ISAS_CONN environment variable, or the built-in default.</summary>
    public StoredProcedureRunner()
        : this(Environment.GetEnvironmentVariable("ISAS_CONN") ?? DefaultConnectionString) { }

    /// <summary>Explicit connection string — handy for tests or DI.</summary>
    public StoredProcedureRunner(string connectionString)
        => _connectionString = connectionString
            ?? throw new ArgumentNullException(nameof(connectionString));

    /// <summary>
    /// Executes a stored procedure and loads the first result set into a DataTable.
    /// Parameters are passed as name/value pairs; a leading '@' is optional.
    /// </summary>
    public async Task<DataTable> ExecuteAsync(
        string procedureName,
        IReadOnlyDictionary<string, object?>? parameters = null,
        int commandTimeoutSeconds = 60,
        CancellationToken cancellationToken = default)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(procedureName);

        await using var connection = new SqlConnection(_connectionString);
        await using var command = new SqlCommand(procedureName, connection)
        {
            CommandType = CommandType.StoredProcedure,
            CommandTimeout = commandTimeoutSeconds
        };

        if (parameters is not null)
        {
            foreach (var (name, value) in parameters)
            {
                // AddWithValue is fine for a quick util. If you hit type-inference
                // issues (money vs decimal, date vs datetime2), switch to
                // command.Parameters.Add(new SqlParameter { ... }) with explicit SqlDbType.
                command.Parameters.AddWithValue(
                    name.StartsWith('@') ? name : "@" + name,
                    value ?? DBNull.Value);
            }
        }

        await connection.OpenAsync(cancellationToken);

        var table = new DataTable();
        await using var reader = await command.ExecuteReaderAsync(cancellationToken);
        table.Load(reader);
        return table;
    }

    /// <summary>
    /// Reads the first data row into a case-insensitive column =&gt; value map.
    /// Values are converted to double and rounded to 5 decimal places.
    /// </summary>
    public static IReadOnlyDictionary<string, double?> ReadMetricRow(DataTable table)
    {
        var map = new Dictionary<string, double?>(StringComparer.OrdinalIgnoreCase);
        if (table.Rows.Count == 0) return map;

        var row = table.Rows[0];
        foreach (DataColumn col in table.Columns)
        {
            var raw = row[col];
            map[col.ColumnName] = raw is null or DBNull
                ? (double?)null
                : Math.Round(Convert.ToDouble(raw), 5, MidpointRounding.AwayFromZero);
        }
        return map;
    }
}

