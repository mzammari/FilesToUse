// ---------------------------------------------------------------------------
// 3) Assign an outcome for each metric.
// ---------------------------------------------------------------------------
public enum MetricOutcome
{
    Favorable,      // moved in the good direction beyond the neutral band
    Unfavorable,    // moved in the bad direction beyond the neutral band
    OnTarget,       // within the neutral band of the baseline
    Informational,  // a driver/volume metric — reported, not graded
    NoData          // value or baseline missing / baseline is zero
}

public enum MetricPolarity
{
    LowerIsBetter,
    HigherIsBetter,
    Informational
}

/// <summary>Which dimension the current value is graded against.</summary>
public enum BaselineDimension
{
    Prior,
    Facility,
    Budget
}

/// <summary>
/// A logical metric and every column that carries it across the four dimensions.
/// CurrentAltKey holds a duplicate current-period column when the SP emits one
/// (e.g. OpFactor + OPFactorTotal, ALOS + ALOSTotal).
/// </summary>
public sealed record MetricFamily(
    string DisplayName,
    MetricPolarity Polarity,
    string CurrentKey,
    string? FacilityKey = null,
    string? PriorKey = null,
    string? BudgetKey = null,
    string? CurrentAltKey = null,
    BaselineDimension DefaultBaseline = BaselineDimension.Prior)
{
    public IEnumerable<string> AllKeys()
    {
        yield return CurrentKey;
        if (CurrentAltKey is not null) yield return CurrentAltKey;
        if (FacilityKey is not null) yield return FacilityKey;
        if (PriorKey is not null) yield return PriorKey;
        if (BudgetKey is not null) yield return BudgetKey;
    }

    public string? BaselineKey(BaselineDimension dim) => dim switch
    {
        BaselineDimension.Prior    => PriorKey,
        BaselineDimension.Facility => FacilityKey,
        BaselineDimension.Budget   => BudgetKey,
        _ => null
    };
}

public sealed record MetricResult(
    string DisplayName,
    double? CurrentValue,
    double? FacilityValue,
    double? PriorValue,
    double? BudgetValue,
    BaselineDimension BaselineUsed,
    double? BaselineValue,
    double? VariancePercent,
    MetricOutcome Outcome);

