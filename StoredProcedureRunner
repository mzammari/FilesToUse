    /// <summary>Columns in MetricColumns.All that no family references. Should be empty.</summary>
    public static IReadOnlyList<string> UnmappedColumns()
    {
        var referenced = new HashSet<string>(
            Families.SelectMany(f => f.AllKeys()), StringComparer.OrdinalIgnoreCase);
        return MetricColumns.All.Where(c => !referenced.Contains(c)).ToList();
    }

    /// <summary>Keys referenced by a family that are missing from MetricColumns.All. Guards typos.</summary>
    public static IReadOnlyList<string> DanglingReferences()
    {
        var known = new HashSet<string>(MetricColumns.All, StringComparer.OrdinalIgnoreCase);
        return Families.SelectMany(f => f.AllKeys())
                       .Where(k => !known.Contains(k))
                       .Distinct(StringComparer.OrdinalIgnoreCase)
                       .ToList();
    }
}

public static class MetricEvaluator
{
    /// <summary>
    /// Grades one family. Within +/- neutralBandPercent of the baseline is OnTarget;
    /// beyond that, direction + polarity decide Favorable vs. Unfavorable.
    /// Pass overrideBaseline to force a dimension (e.g. grade everything vs. Facility).
    /// </summary>
    public static MetricResult Evaluate(
        MetricFamily family,
        IReadOnlyDictionary<string, double?> row,
        double neutralBandPercent = 1.0,
        BaselineDimension? overrideBaseline = null)
    {
        double? Get(string? key) => key is not null && row.TryGetValue(key, out var v) ? v : null;

        var current  = Get(family.CurrentKey) ?? Get(family.CurrentAltKey);
        var facility = Get(family.FacilityKey);
        var prior    = Get(family.PriorKey);
        var budget   = Get(family.BudgetKey);

        var dim = overrideBaseline ?? family.DefaultBaseline;
        var baseline = Get(family.BaselineKey(dim));

        if (current is null || baseline is null || baseline.Value == 0.0)
            return new MetricResult(family.DisplayName, current, facility, prior, budget,
                dim, baseline, null, MetricOutcome.NoData);

        var variancePct = (current.Value - baseline.Value) / Math.Abs(baseline.Value) * 100.0;
        var rounded = Math.Round(variancePct, 5, MidpointRounding.AwayFromZero);

        MetricOutcome outcome;
        if (family.Polarity == MetricPolarity.Informational)
            outcome = MetricOutcome.Informational;
        else if (Math.Abs(variancePct) <= neutralBandPercent)
            outcome = MetricOutcome.OnTarget;
        else
        {
            var improved = family.Polarity == MetricPolarity.LowerIsBetter
                ? variancePct < 0
                : variancePct > 0;
            outcome = improved ? MetricOutcome.Favorable : MetricOutcome.Unfavorable;
        }

        return new MetricResult(family.DisplayName, current, facility, prior, budget,
            dim, baseline, rounded, outcome);
    }

    /// <summary>Grades every registered family against a single result row.</summary>
    public static IReadOnlyList<MetricResult> EvaluateAll(
        IReadOnlyDictionary<string, double?> row,
        double neutralBandPercent = 1.0,
        BaselineDimension? overrideBaseline = null)
        => MetricFamilyRegistry.Families
            .Select(f => Evaluate(f, row, neutralBandPercent, overrideBaseline))
            .ToList();
}

