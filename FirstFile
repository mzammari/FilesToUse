using System;
using System.Collections.Generic;
using System.Data;
using System.Globalization;
using System.Data.SqlClient;

namespace ISAS_Regression_Automation
{
    /// <summary>
    /// Both panels of the Non-Productive stored procedure for one dept.
    /// Every value is the raw string SQL Server sent back ("" for NULL).
    /// </summary>
    public class SqlProcRunner
    {
        /// <summary>
        /// FIRST panel row for the dept: Number, Name, DeptType, NonProductiveHoursTotal, Jan..Dec,
        /// ForecastEmpProdFte, FteImpact, NonProductivePercentTotal, HVJan..HVDec,
        /// HistoricalNonProductivePercent.
        /// </summary>
        public Dictionary<string, string> Summary { get; set; }

        /// <summary>
        /// SECOND panel rows for the dept, keyed by Month ("1" = Jan .. "12" = Dec): Number, Name,
        /// DeptType, Month, NonProductivePercent, HistoricalDepartmentTotalUos, HistoricalValue,
        /// HistNPPValue, NonProductiveHoursTotal, TotalProductiveFtesTotal, TotalProductiveHoursTotal,
        /// ContractLaborHoursTotal, ContractLaborFtesTotal, NonProductivePercentTotal,
        /// HistoricalPaidHours, HistoricalProductiveHours.
        /// </summary>
        public Dictionary<string, Dictionary<string, string>> Monthly { get; set; }
    }

    /// <summary>
    /// Runs the Non-Productive stored procedure for the plan in RunData.PlanID and reads its
    /// result sets ("panels" in SSMS). Every value is returned as the raw string SQL Server
    /// sent back - no conversion to double/decimal.
    ///
    /// Usage:
    ///   SqlProcRunner.ConnectionString = connStr;   // set once, e.g. in [OneTimeSetUp]
    ///   RunData.PlanID = GetPlanID();               // plan ID taken from the UI
    ///
    ///   var data = SqlProcRunner.GetDeptData("dbo.usp_YourProcName", "722");
    ///
    ///   // First panel (searched by dept)
    ///   string name  = data.Summary["Name"];                        // "ANESTHESIA"
    ///   string jan   = data.Summary["Jan"];                         // "8.763"
    ///   string hvJan = data.Summary["HVJan"];                       // "8.76"
    ///   string fte   = data.Summary["FteImpact"];                   // "0.036"
    ///
    ///   // Second panel (all rows for the dept, by month)
    ///   string janNp   = data.Monthly["1"]["NonProductivePercent"]; // "8.763"
    ///   string janHist = data.Monthly["1"]["HistNPPValue"];         // "7.026"
    ///   string decPaid = data.Monthly["12"]["HistoricalPaidHours"]; // "1853"
    /// </summary>
    public static class SqlProcRunner
    {
        /// <summary>
        /// Connection string used by every method in this class. Set it once before calling.
        /// </summary>
        public static string ConnectionString { get; set; }

        /// <summary>
        /// Name of the procedure's plan ID parameter. Change it if the procedure uses a different name.
        /// </summary>
        public static string PlanParamName { get; set; } = "@PlanId";

        /// <summary>
        /// Run the procedure ONCE for RunData.PlanID and return both panels for one dept:
        /// the first-panel row whose Number = dept, and the second-panel rows for that dept by month.
        /// </summary>
        public static DeptProcData GetDeptData(string procName, string dept)
        {
            if (string.IsNullOrWhiteSpace(dept))
                throw new ArgumentException("Department number is required.", nameof(dept));

            dept = dept.Trim();
            var resultSets = ExecuteStoredProcedureAllResultSets(procName);

            if (resultSets.Count < 2)
                throw new InvalidOperationException(
                    $"'{procName}' returned {resultSets.Count} result set(s); 2 were expected.");

            // ---- First panel: search by dept ----
            Dictionary<string, string> summary = null;
            foreach (var row in resultSets[0])
            {
                if (row.TryGetValue("Number", out var num) && dept.Equals(num, StringComparison.OrdinalIgnoreCase))
                {
                    summary = row;
                    break;
                }
            }

            if (summary == null)
                throw new KeyNotFoundException(
                    $"Dept '{dept}' not found in result set 1 for plan ID '{RunData.PlanID}' " +
                    $"({resultSets[0].Count} row(s) returned).");

            // ---- Second panel: all rows for the dept, keyed by Month ----
            var monthly = new Dictionary<string, Dictionary<string, string>>(StringComparer.OrdinalIgnoreCase);
            foreach (var row in resultSets[1])
            {
                // Skip rows for other depts, in case the second panel ever holds more than one
                if (row.TryGetValue("Number", out var num) && !dept.Equals(num, StringComparison.OrdinalIgnoreCase))
                    continue;

                string month = row.TryGetValue("Month", out var m) ? m : "";
                string key = month;
                for (int n = 2; monthly.ContainsKey(key); n++)
                    key = $"{month}_{n}";

                monthly[key] = row;
            }

            if (monthly.Count == 0)
                Console.WriteLine($"Warning: no rows for dept '{dept}' in result set 2 for plan ID '{RunData.PlanID}'");

            return new DeptProcData { Summary = summary, Monthly = monthly };
        }

        /// <summary>
        /// Execute the stored procedure ONCE for RunData.PlanID and return every result set.
        /// resultSets[0] = first panel, resultSets[1] = second panel, ...
        /// Each row is column name -> raw string value ("" for NULL).
        /// </summary>
        public static List<List<Dictionary<string, string>>> ExecuteStoredProcedureAllResultSets(
            string procName,
            int commandTimeoutSeconds = 120)
        {
            if (string.IsNullOrWhiteSpace(ConnectionString))
                throw new InvalidOperationException(
                    "SqlProcRunner.ConnectionString is not set. Set it before running a stored procedure.");

            string planId = Convert.ToString(RunData.PlanID, CultureInfo.InvariantCulture)?.Trim();
            if (string.IsNullOrWhiteSpace(planId))
                throw new InvalidOperationException(
                    "RunData.PlanID is empty. Set it (RunData.PlanID = GetPlanID()) before running the procedure.");

            var resultSets = new List<List<Dictionary<string, string>>>();

            using (var conn = new SqlConnection(ConnectionString))
            using (var cmd = new SqlCommand(procName, conn))
            {
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.CommandTimeout = commandTimeoutSeconds;

                // Plan ID taken from the UI via RunData.PlanID
                cmd.Parameters.AddWithValue(PlanParamName, planId);

                conn.Open();
                using (var reader = cmd.ExecuteReader())
                {
                    do
                    {
                        var rows = new List<Dictionary<string, string>>();
                        while (reader.Read())
                        {
                            var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                            for (int col = 0; col < reader.FieldCount; col++)
                                row[reader.GetName(col)] = RawText(reader.GetValue(col));
                            rows.Add(row);
                        }
                        resultSets.Add(rows);
                    }
                    while (reader.NextResult());   // move to the next panel
                }
            }

            for (int i = 0; i < resultSets.Count; i++)
                Console.WriteLine($"'{procName}' plan {planId}, result set {i + 1}: {resultSets[i].Count} row(s)");

            return resultSets;
        }

        /// <summary>
        /// Value as text with no numeric conversion. Decimals keep the scale SQL Server returns
        /// (the same digits SSMS shows); NULL becomes "".
        /// </summary>
        private static string RawText(object value)
        {
            if (value == null || value == DBNull.Value)
                return "";
            if (value is IFormattable f)
                return f.ToString(null, CultureInfo.InvariantCulture).Trim();
            return value.ToString().Trim();
        }
    }
}
