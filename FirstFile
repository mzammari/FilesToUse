[TestCase("600")]
public void ContractManhours_ExcelMatchesDb(string dept)
{
    var excelRow = LegacyContractManhoursExcel.QueryByDept(ExcelFile, dept);
    var dbRows   = LegacyContractManhoursDb.GetDeptMonths(Query, dept);
    var results  = LegacyContractManhoursComparer.CompareRow(dept, excelRow, dbRows);

    Assert.That(results.Where(r => !r.Match), Is.Empty, string.Join(Environment.NewLine, results));
}



using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;

namespace ISAS_Regression_Automation
{
    /// <summary>One Excel field checked against the DB (DB is the source of truth).</summary>
    public class ManhoursCompareResult
    {
        public string Dept { get; set; }
        public string ExcelColumn { get; set; }
        public string DbColumn { get; set; }
        public string ExcelValue { get; set; }
        public string DbValue { get; set; }
        public bool Match { get; set; }

        public override string ToString() =>
            $"{(Match ? "PASS" : "FAIL")}  Dept {Dept}  {ExcelColumn,-22} Excel='{ExcelValue}'  DB({DbColumn})='{DbValue}'";
    }

    /// <summary>
    /// Compares the Legacy Contract Manhours Excel row for a dept against the DB's 12 rows.
    ///
    /// NO ROUNDING. Two numbers are compared as exact decimals (never double), so
    /// "241.9759" matches "241.97590" and "0" matches "0.00000", but "241.9759" does NOT
    /// match "241.97591". Anything non-numeric must match as text (case-insensitive).
    ///
    /// Usage:
    ///   LegacyContractManhoursDb.ConnectionString = "...";
    ///   var results = LegacyContractManhoursComparer.CompareDept(excelFile, query, "600");
    ///   results.ForEach(Console.WriteLine);
    ///   Assert.That(results.Where(r => !r.Match), Is.Empty);
    /// </summary>
    public static class LegacyContractManhoursComparer
    {
        /// <summary>Excel header -> DB column (months come from FldVal by ColName).</summary>
        public static readonly List<KeyValuePair<string, string>> FieldMap = BuildMap();

        private static List<KeyValuePair<string, string>> BuildMap()
        {
            var map = new List<KeyValuePair<string, string>>
            {
                new("Year",            "Year"),
                new("Plan",            "Plan"),
                new("CoId",            "CoId"),
                new("Description",     "Description"),
                new("Dept#",           "Dept"),
                new("DeptDescription", "DeptDescription"),
                new("Category",        "DeptType"),
            };
            foreach (var m in LegacyContractManhoursExcel.MonthNames)
                map.Add(new("ContractManhours_" + m, "FldVal (ColName=ContractManhours_" + m + ")"));
            return map;
        }

        /// <summary>Compare one dept: Excel row vs. the DB's 12 rows. Returns every field, pass or fail.</summary>
        public static List<ManhoursCompareResult> CompareDept(
            string excelFile,
            string query,
            string dept,
            IDictionary<string, object> parameters = null)
        {
            var excelRow = LegacyContractManhoursExcel.QueryByDept(excelFile, dept);
            var dbRows   = LegacyContractManhoursDb.GetDeptMonths(query, dept, parameters);
            var dbRow    = LegacyContractManhoursDb.ToExcelRow(dbRows);

            return CompareRow(dept, excelRow, dbRow);
        }

        /// <summary>Compare an Excel row and a DB row that are already keyed by Excel headers.</summary>
        public static List<ManhoursCompareResult> CompareRow(
            string dept,
            Dictionary<string, string> excelRow,
            Dictionary<string, string> dbRow)
        {
            var results = new List<ManhoursCompareResult>();

            foreach (var kv in FieldMap)
            {
                bool inExcel = excelRow.TryGetValue(kv.Key, out var excelVal);
                bool inDb    = dbRow.TryGetValue(kv.Key, out var dbVal);

                results.Add(new ManhoursCompareResult
                {
                    Dept        = dept,
                    ExcelColumn = kv.Key,
                    DbColumn    = kv.Value,
                    ExcelValue  = inExcel ? excelVal : "<missing in Excel>",
                    DbValue     = inDb    ? dbVal    : "<missing in DB>",
                    Match       = inExcel && inDb && ValuesMatch(kv.Key, excelVal, dbVal)
                });
            }

            return results;
        }

        /// <summary>
        /// Exact match, no rounding. Numbers compare as decimals; text compares case-insensitively.
        /// Category also matches when the Excel value equals one "/" part of the DB DeptType
        /// (same rule as the Non-Productive comparer).
        /// </summary>
        public static bool ValuesMatch(string excelColumn, string excelVal, string dbVal)
        {
            excelVal = (excelVal ?? "").Trim();
            dbVal    = (dbVal ?? "").Trim();

            if (TryDec(excelVal, out var a) && TryDec(dbVal, out var b))
                return a == b;

            if (excelVal.Equals(dbVal, StringComparison.OrdinalIgnoreCase))
                return true;

            if (excelColumn.Equals("Category", StringComparison.OrdinalIgnoreCase))
                return dbVal.Split('/').Any(p => p.Trim().Equals(excelVal, StringComparison.OrdinalIgnoreCase));

            return false;
        }

        private static bool TryDec(string s, out decimal d) =>
            decimal.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out d);
    }
}
