        public static void CloseAllTab()
        {
            CommonFunctions.WaitUntilPageIsAcive();
            var windowHandleSet = Driver.Instance.WindowHandles;
            List<string> tabs = new List<string>(windowHandleSet);
            foreach (var tab in tabs)
            {
                Driver.Instance.SwitchTo().Window(tab);
               // Driver.Instance.Close();
                if (isAlertPresent())
                {
                    Driver.Instance.SwitchTo().Alert().Accept();
                    Thread.Sleep(2000);
                }
                Driver.Instance.Close();
            }
        }

