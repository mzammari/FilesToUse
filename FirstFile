        private static  async Task<string> GetNodeUrl(string hubUrl, string sessionId)
        {
            using (HttpClient client = new HttpClient())
            {
                try
                {
                    // For Selenium Grid 3
                    string apiUrl = $"{hubUrl}/grid/api/testsession?session={sessionId}";
                    HttpResponseMessage response = await client.GetAsync(apiUrl);

                    if (response.IsSuccessStatusCode)
                    {
                        string content = await response.Content.ReadAsStringAsync();

                        // Parse JSON response
                        var json = Newtonsoft.Json.Linq.JObject.Parse(content);
                        string proxyId = json["proxyId"]?.ToString();

                        if (!string.IsNullOrEmpty(proxyId))
                        {
                            return proxyId;
                        }
                    }

                    // If Grid 3 API fails, try Grid 4 GraphQL
                    return await GetNodeUrlGrid4(hubUrl, sessionId);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error getting node URL: {ex.Message}");
                    return "Unknown Node";
                }
            }
        }

        private static async Task<string> GetNodeUrlGrid4(string hubUrl, string sessionId)
        {
            using (HttpClient client = new HttpClient())
            {
                try
                {
                    // Remove /wd/hub if present
                    string baseHubUrl = hubUrl.Replace("/wd/hub", "").TrimEnd('/');

                    // Grid 4 GraphQL endpoint
                    string graphqlUrl = $"{baseHubUrl}/graphql";

                    Console.WriteLine($"Querying Grid 4 at: {graphqlUrl}");
                    Console.WriteLine($"For Session ID: {sessionId}");

                    // GraphQL query for Grid 4
                    var requestBody = new
                    {
                        query = @"
                    query($sessionId: ID!) {
                        session(id: $sessionId) {
                            id
                            nodeId
                            nodeUri
                            sessionDurationMillis
                            slot {
                                id
                                stereotype
                            }
                        }
                    }",
                        variables = new
                        {
                            sessionId = sessionId
                        }
                    };

                    string jsonRequest = Newtonsoft.Json.JsonConvert.SerializeObject(requestBody);
                    Console.WriteLine($"Request: {jsonRequest}");

                    var content = new StringContent(jsonRequest, System.Text.Encoding.UTF8, "application/json");

                    HttpResponseMessage response = await client.PostAsync(graphqlUrl, content);
                    string result = await response.Content.ReadAsStringAsync();

                    Console.WriteLine($"Response Status: {response.StatusCode}");
                    Console.WriteLine($"Response: {result}");

                    if (response.IsSuccessStatusCode)
                    {
                        var jsonResponse = Newtonsoft.Json.Linq.JObject.Parse(result);

                        // Check for errors
                        var errors = jsonResponse["errors"];
                        if (errors != null)
                        {
                            Console.WriteLine($"GraphQL Errors: {errors}");
                            return "GraphQL Query Error";
                        }

                        // Extract node information
                        var sessionData = jsonResponse["data"]?["session"];
                        if (sessionData != null)
                        {
                            string nodeUri = sessionData["nodeUri"]?.ToString();
                            string nodeId = sessionData["nodeId"]?.ToString();

                            Console.WriteLine($"Node URI: {nodeUri}");
                            Console.WriteLine($"Node ID: {nodeId}");

                            if (!string.IsNullOrEmpty(nodeUri))
                            {
                                return nodeUri;
                            }
                            else if (!string.IsNullOrEmpty(nodeId))
                            {
                                return $"Node ID: {nodeId}";
                            }
                        }
                        else
                        {
                            Console.WriteLine("Session data is null - session might not be registered yet");
                        }
                    }

                    return "Could not retrieve node information";
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error: {ex.Message}");
                    Console.WriteLine($"Stack Trace: {ex.StackTrace}");
                    return $"Error: {ex.Message}";
                }
            }
        }


        /// <summary>
        /// Get secrets values (username, pwd, PAT...etc) from either the 
        /// environment variable or secrets file
        /// </summary>
        /// <param name="key"></param>
        /// <returns>value</returns>
        public static string Get(string key)
        {
            //Access the secrets file locally
            var config = new ConfigurationBuilder()
              .AddUserSecrets(Assembly.GetExecutingAssembly(), true).Build();

            var value = Environment.GetEnvironmentVariable(key);
            if (!string.IsNullOrEmpty(value))
            {
                return value;
            }
            else
            {
                return config[key];
            }
        }

        public static T Get<T>(string key) where T : IConvertible
        {
            // First try environment variables (GitHub Actions, Docker, etc.)
            string envValue = Environment.GetEnvironmentVariable(key);

            if (!string.IsNullOrEmpty(envValue))
            {
                Console.WriteLine($"Found {key} in environment variables");
                return ConvertValue<T>(envValue, key, "environment variable");
            }

            // Fall back to user secrets (local development)
            var config = new ConfigurationBuilder()
                .AddUserSecrets(Assembly.GetExecutingAssembly(), true)
                .Build();

            string configValue = config[key];

            if (!string.IsNullOrEmpty(configValue))
            {
                Console.WriteLine($"Found {key} in user secrets");
                return ConvertValue<T>(configValue, key, "user secrets");
            }

            // Final fallback - could also check appsettings.json
            Console.WriteLine($"Warning: {key} not found in environment variables or user secrets, returning default");
            return default(T);
        }

        private static T ConvertValue<T>(string value, string key, string source) where T : IConvertible
        {
            // For boolean values with flexible parsing
            if (typeof(T) == typeof(bool))
            {
                if (bool.TryParse(value, out bool result))
                    return (T)(object)result;

                string lower = value.ToLowerInvariant();
                bool boolValue = lower == "true" || lower == "1" || lower == "yes" || lower == "on";
                return (T)(object)boolValue;
            }

            // For other types
            try
            {
                return (T)Convert.ChangeType(value, typeof(T));
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException(
                    $"Cannot convert {source} '{key}' value '{value}' to type {typeof(T).Name}", ex);
            }
        }

