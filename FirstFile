using System;
using System.Collections.Generic;
using System.Data;
using System.Globalization;
using Microsoft.Data.SqlClient;

namespace ISAS_Regression_Automation
{
    /// <summary>
    /// Runs a SQL Server stored procedure and reads one of its result sets ("panels" in SSMS).
    /// Every value is returned as the raw string SQL Server sent back - no conversion to double/decimal.
    ///
    /// Usage:
    ///   string dept = "722";
    ///   var months = SqlProcRunner.GetDeptMonthlyData(connStr, "dbo.usp_YourProcName", dept);
    ///
    ///   string janNp   = months["1"]["NonProductivePercent"];   // "8.763"
    ///   string janHist = months["1"]["HistNPPValue"];           // "7.026"
    ///   string decNp   = months["12"]["NonProductivePercent"];  // "11.817"
    /// </summary>
    public static class SqlProcRunner
    {
        /// <summary>
        /// Execute a stored procedure and return the rows of one result set.
        /// resultSetIndex is 0-based: 0 = first panel, 1 = second panel.
        /// Each row is column name -> raw string value ("" for NULL).
        /// </summary>
        public static List<Dictionary<string, string>> ExecuteStoredProcedure(
            string connectionString,
            string procName,
            Dictionary<string, object> parameters = null,
            int resultSetIndex = 1,
            int commandTimeoutSeconds = 120)
        {
            using var conn = new SqlConnection(connectionString);
            using var cmd = new SqlCommand(procName, conn)
            {
                CommandType = CommandType.StoredProcedure,
                CommandTimeout = commandTimeoutSeconds
            };

            if (parameters != null)
            {
                foreach (var p in parameters)
                {
                    string name = p.Key.StartsWith("@") ? p.Key : "@" + p.Key;
                    cmd.Parameters.AddWithValue(name, p.Value ?? DBNull.Value);
                }
            }

            conn.Open();
            using var reader = cmd.ExecuteReader();

            // Skip ahead to the requested result set
            for (int i = 0; i < resultSetIndex; i++)
            {
                if (!reader.NextResult())
                    throw new InvalidOperationException(
                        $"'{procName}' returned only {i + 1} result set(s); result set {resultSetIndex + 1} was requested.");
            }

            var rows = new List<Dictionary<string, string>>();
            while (reader.Read())
            {
                var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                for (int col = 0; col < reader.FieldCount; col++)
                    row[reader.GetName(col)] = RawText(reader.GetValue(col));
                rows.Add(row);
            }

            Console.WriteLine($"'{procName}' result set {resultSetIndex + 1}: {rows.Count} row(s)");
            return rows;
        }

        /// <summary>
        /// Run the Non-Productive procedure for one department and return the SECOND result set
        /// (the current dept's monthly rows), keyed by the Month column: "1" (Jan) .. "12" (Dec).
        /// Only rows whose Number matches the dept are kept.
        /// </summary>
        public static Dictionary<string, Dictionary<string, string>> GetDeptMonthlyData(
            string connectionString,
            string procName,
            string dept,
            string deptParamName = "@Dept",
            Dictionary<string, object> otherParameters = null)
        {
            if (string.IsNullOrWhiteSpace(dept))
                throw new ArgumentException("Department number is required.", nameof(dept));
            dept = dept.Trim();

            var parameters = new Dictionary<string, object>(otherParameters ?? new Dictionary<string, object>())
            {
                [deptParamName] = dept
            };

            var rows = ExecuteStoredProcedure(connectionString, procName, parameters, resultSetIndex: 1);

            var byMonth = new Dictionary<string, Dictionary<string, string>>(StringComparer.OrdinalIgnoreCase);
            foreach (var row in rows)
            {
                if (row.TryGetValue("Number", out var number) && number != dept)
                    continue;

                string month = row.TryGetValue("Month", out var m) ? m : "";
                string key = month;
                for (int n = 2; byMonth.ContainsKey(key); n++)
                    key = $"{month}_{n}";

                byMonth[key] = row;
            }

            if (byMonth.Count == 0)
                Console.WriteLine($"Warning: no rows in result set 2 for Number = '{dept}'");

            return byMonth;
        }

        /// <summary>
        /// Value as text with no numeric conversion. Decimals keep the scale SQL Server returns
        /// (the same digits SSMS shows); NULL becomes "".
        /// </summary>
        private static string RawText(object value)
        {
            if (value == null || value == DBNull.Value)
                return "";
            if (value is IFormattable f)
                return f.ToString(null, CultureInfo.InvariantCulture).Trim();
            return value.ToString().Trim();
        }
    }
}
