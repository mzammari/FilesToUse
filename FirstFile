using System;
using System.Collections.Generic;
using System.Linq;

namespace HealthTrust.LaborMetrics;

/// <summary>
/// Yearly forecast summary. Each property is a display metric from the summary
/// grid, prefixed with "Forecast", populated from the matching DB column on a
/// <see cref="LaborMetricRow"/>.
/// </summary>
public sealed class LaborSummaryYearlyForecast
{
    public double? ForecastAdmissions { get; set; }
    public double? ForecastAdjustedAdmissions { get; set; }
    public double? ForecastPatientDays { get; set; }
    public double? ForecastAPD { get; set; }
    public double? ForecastERVisits { get; set; }
    public double? ForecastOutpatientVisits { get; set; }
    public double? ForecastOPFactor { get; set; }
    public double? ForecastALOS { get; set; }
    public double? ForecastEEOB { get; set; }
    public double? ForecastMHAA { get; set; }

    // -----------------------------------------------------------------------
    // Mapping: assign each DB value from the row to its Forecast property.
    // -----------------------------------------------------------------------

    /// <summary>Builds a forecast summary from one DB row.</summary>
    public static LaborSummaryYearlyForecast FromLaborMetricRow(LaborMetricRow row)
    {
        ArgumentNullException.ThrowIfNull(row);

        return new LaborSummaryYearlyForecast
        {
            ForecastAdmissions         = row.Admissions,
            ForecastAdjustedAdmissions = row.AAdmissions,
            ForecastPatientDays        = row.PatientDays,
            ForecastAPD                = row.APatientDays,
            ForecastERVisits           = row.ERVisits,
            ForecastOutpatientVisits   = row.Outpatient,
            ForecastOPFactor           = row.OPFactorTotal,
            ForecastALOS               = row.ALOSTotal,
            ForecastEEOB               = row.EeobTotal,
            ForecastMHAA               = row.MhAaTotal,
        };
    }

    /// <summary>Builds a forecast summary for each DB row.</summary>
    public static IReadOnlyList<LaborSummaryYearlyForecast> FromLaborMetricRows(
        IEnumerable<LaborMetricRow> rows)
    {
        ArgumentNullException.ThrowIfNull(rows);
        return rows.Select(FromLaborMetricRow).ToList();
    }
}
