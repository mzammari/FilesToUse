string loginCred = $"{RunData.Domain}\\{RunData.UserName}";

var bidi = await ((WebDriver)Instance).AsBiDiAsync();

// register the auth responder BEFORE navigating
await bidi.Network.OnAuthRequiredAsync(async e =>
{
    // exact type names below can vary by Selenium version — confirm via IntelliSense
    await bidi.Network.ContinueWithAuthAsync(
        e.Request,
        new AuthCredentials(loginCred, RunData.Password));
});

NavigateToIsas();
