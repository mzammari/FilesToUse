        /// <summary>
        /// Answers the ISAS NTLM/Basic auth challenge via a CDP Fetch session pinned to
        /// protocol version 144, so Selenium's DevTools auto-detect never negotiates the
        /// installed Chrome version and throws "DevTools version is not in the supported range".
        /// Direct replacement for the old Manage().Network + NetworkAuthenticationHandler block.
        /// Unlike the old block there is no Start/StopMonitoring lifecycle: the handlers stay
        /// registered for the whole session, which also prevents the credential dialog from
        /// reappearing on later navigations.
        /// </summary>
        private static async Task SetupPinnedAuth()
        {
            string loginCred = $"{RunData.Domain}\\{RunData.UserName}";

            var session = ((IDevTools)Instance)
                .GetDevToolsSession(new DevToolsOptions { ProtocolVersion = 144 });
            var domains = session.GetVersionSpecificDomains<OpenQA.Selenium.DevTools.V144.DevToolsSessionDomains>();

            // Enable Fetch and opt in to handling auth challenges.
            await domains.Fetch.Enable(new OpenQA.Selenium.DevTools.V144.Fetch.EnableCommandSettings
            {
                HandleAuthRequests = true,
                Patterns = new[]
                {
                    new OpenQA.Selenium.DevTools.V144.Fetch.RequestPattern { UrlPattern = "*" }
                }
            });

            // With Fetch enabled, EVERY request pauses waiting for an instruction.
            // Non-auth requests must be continued or the page will hang.
            domains.Fetch.RequestPaused += async (s, e) =>
            {
                try
                {
                    await domains.Fetch.ContinueRequest(
                        new OpenQA.Selenium.DevTools.V144.Fetch.ContinueRequestCommandSettings
                        {
                            RequestId = e.RequestId
                        });
                }
                catch
                {
                    // Request may already be resolved/gone by the time we continue it; safe to ignore.
                }
            };

            // Answer the 401 challenge with the domain credentials.
            domains.Fetch.AuthRequired += async (s, e) =>
            {
                await domains.Fetch.ContinueWithAuth(
                    new OpenQA.Selenium.DevTools.V144.Fetch.ContinueWithAuthCommandSettings
                    {
                        RequestId = e.RequestId,
                        AuthChallengeResponse = new OpenQA.Selenium.DevTools.V144.Fetch.AuthChallengeResponse
                        {
                            Response = "ProvideCredentials",
                            Username = loginCred,
                            Password = RunData.Password
                        }
                    });
            };
        }

