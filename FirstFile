        private static void EndTest()
        {
            Steps.EndTestSteps();
            string? errMsg;
            var testStatus = TestContext.CurrentContext.Result.Outcome.Status;
            var message = TestContext.CurrentContext.Result.Message;
            switch(testStatus) 
            {
                case TestStatus.Failed:
                    ExtentReporting.LogFail($"Test has failed {message}");
                    RunData.testResult = "failed";
                    RunData.isPass = false;
                    ExtentReporting.LogScreenshot("Ending test", getScreenshot());
                    errMsg = TestContext.CurrentContext.Result.Message;
                    CommonFunctions.AddTestStep("Test failed", errMsg);
                    AdoUpdaer.SetAdoResult();                    
                    break;
                case TestStatus.Passed:
                    ExtentReporting.LogPass($"Test has passed");
                    RunData.testResult = "passed";
                    RunData.isPass = true;
                    ExtentReporting.LogScreenshot("Ending test", getScreenshot());
                    AdoUpdaer.SetAdoResult();                   
                    break;
                case TestStatus.Skipped:
                   // ExtentReporting.LogInfo($"Test skipped {message}");
                    break;
            }            
        }

        private static void GetFilesAndDelete(string path, params string[] extensions)
        {
            List<FileInfo> list = new List<FileInfo>();
            if (Directory.Exists(path))
            {
                foreach (string ext in extensions)
                {
                    list.AddRange(new DirectoryInfo(path).GetFiles("*" + ext).Where(p =>
                          p.Extension.Equals(ext, StringComparison.CurrentCultureIgnoreCase))
                          .ToArray());
                }

                foreach(var file in list)
                {
                    try
                    {
                        file.Attributes = FileAttributes.Normal;
                        File.Delete(file.FullName);
                    }
                    catch
                    {
                        continue;
                    }

                }
            }
        }

