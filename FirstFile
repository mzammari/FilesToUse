using System;
using System.Collections.Generic;
using System.Data;
using System.Globalization;
using System.Data.SqlClient;

namespace ISAS_Regression_Automation
{
    /// <summary>
    /// Runs the Non-Productive stored procedure for the plan in RunData.PlanID and reads
    /// one of its result sets ("panels" in SSMS). Every value is returned as the raw string
    /// SQL Server sent back - no conversion to double/decimal.
    ///
    /// Usage:
    ///   SqlProcRunner.ConnectionString = connStr;   // set once, e.g. in [OneTimeSetUp]
    ///   RunData.PlanID = GetPlanID();               // plan ID taken from the UI
    ///
    ///   var row = SqlProcRunner.GetDeptSummaryData("dbo.usp_YourProcName", "722");
    ///   string name  = row["Name"];                        // "ANESTHESIA"
    ///   string janNp = row["Jan"];                         // "8.763"
    ///   string hvJan = row["HVJan"];                       // "8.76"
    ///   string total = row["NonProductivePercentTotal"];   // "8.201"
    ///
    ///   // Or every dept in the first panel, keyed by dept number:
    ///   var all = SqlProcRunner.GetAllDeptsSummaryData("dbo.usp_YourProcName");
    ///   string fte = all["722"]["FteImpact"];              // "0.036"
    /// </summary>
    public static class SqlProcRunner
    {
        /// <summary>
        /// Connection string used by every method in this class. Set it once before calling.
        /// </summary>
        public static string ConnectionString { get; set; }

        /// <summary>
        /// Name of the procedure's plan ID parameter. Change it if the procedure uses a different name.
        /// </summary>
        public static string PlanParamName { get; set; } = "@PlanId";

        /// <summary>
        /// Execute the stored procedure for RunData.PlanID and return the rows of one result set.
        /// resultSetIndex is 0-based: 0 = first panel, 1 = second panel.
        /// Each row is column name -> raw string value ("" for NULL).
        /// </summary>
        public static List<Dictionary<string, string>> ExecuteStoredProcedure(
            string procName,
            int resultSetIndex = 0,
            int commandTimeoutSeconds = 120)
        {
            if (string.IsNullOrWhiteSpace(ConnectionString))
                throw new InvalidOperationException(
                    "SqlProcRunner.ConnectionString is not set. Set it before running a stored procedure.");

            string planId = Convert.ToString(RunData.PlanID, CultureInfo.InvariantCulture)?.Trim();
            if (string.IsNullOrWhiteSpace(planId))
                throw new InvalidOperationException(
                    "RunData.PlanID is empty. Set it (RunData.PlanID = GetPlanID()) before running the procedure.");

            var rows = new List<Dictionary<string, string>>();

            using (var conn = new SqlConnection(ConnectionString))
            using (var cmd = new SqlCommand(procName, conn))
            {
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.CommandTimeout = commandTimeoutSeconds;

                // Plan ID taken from the UI via RunData.PlanID
                cmd.Parameters.AddWithValue(PlanParamName, planId);

                conn.Open();
                using (var reader = cmd.ExecuteReader())
                {
                    // Skip ahead to the requested result set (0 = first panel, no skipping)
                    for (int i = 0; i < resultSetIndex; i++)
                    {
                        if (!reader.NextResult())
                            throw new InvalidOperationException(
                                $"'{procName}' returned only {i + 1} result set(s); result set {resultSetIndex + 1} was requested.");
                    }

                    while (reader.Read())
                    {
                        var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                        for (int col = 0; col < reader.FieldCount; col++)
                            row[reader.GetName(col)] = RawText(reader.GetValue(col));
                        rows.Add(row);
                    }
                }
            }

            Console.WriteLine($"'{procName}' plan {planId}, result set {resultSetIndex + 1}: {rows.Count} row(s)");
            return rows;
        }

        /// <summary>
        /// FIRST result set (one summary row per dept) for RunData.PlanID, keyed by the
        /// Number column (dept number, e.g. "722").
        /// Columns in each row: Number, Name, DeptType, NonProductiveHoursTotal, Jan..Dec,
        /// ForecastEmpProdFte, FteImpact, NonProductivePercentTotal, HVJan..HVDec,
        /// HistoricalNonProductivePercent.
        /// </summary>
        public static Dictionary<string, Dictionary<string, string>> GetAllDeptsSummaryData(string procName)
        {
            var rows = ExecuteStoredProcedure(procName, resultSetIndex: 0);

            var byDept = new Dictionary<string, Dictionary<string, string>>(StringComparer.OrdinalIgnoreCase);
            foreach (var row in rows)
            {
                string dept = row.TryGetValue("Number", out var d) ? d : "";
                string key = dept;
                for (int n = 2; byDept.ContainsKey(key); n++)
                    key = $"{dept}_{n}";

                byDept[key] = row;
            }

            if (byDept.Count == 0)
                Console.WriteLine($"Warning: no rows in result set 1 for plan ID '{RunData.PlanID}'");

            return byDept;
        }

        /// <summary>
        /// FIRST result set row for one dept (matched on the Number column), for RunData.PlanID.
        /// </summary>
        public static Dictionary<string, string> GetDeptSummaryData(string procName, string dept)
        {
            if (string.IsNullOrWhiteSpace(dept))
                throw new ArgumentException("Department number is required.", nameof(dept));

            var byDept = GetAllDeptsSummaryData(procName);

            if (byDept.TryGetValue(dept.Trim(), out var row))
                return row;

            throw new KeyNotFoundException(
                $"Dept '{dept}' not found in result set 1 for plan ID '{RunData.PlanID}' ({byDept.Count} dept(s) returned).");
        }

        /// <summary>
        /// Value as text with no numeric conversion. Decimals keep the scale SQL Server returns
        /// (the same digits SSMS shows); NULL becomes "".
        /// </summary>
        private static string RawText(object value)
        {
            if (value == null || value == DBNull.Value)
                return "";
            if (value is IFormattable f)
                return f.ToString(null, CultureInfo.InvariantCulture).Trim();
            return value.ToString().Trim();
        }
    }
}
