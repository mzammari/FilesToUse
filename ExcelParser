using System;
using System.Collections.Generic;
using System.Data;
using System.Data.SqlClient;
using System.Globalization;
using System.Linq;

namespace ISAS_Regression_Automation
{
    /// <summary>
    /// Runs the Legacy Contract Manhours query you pass in and returns the 12 monthly rows
    /// (Month 1..12) for one department.
    ///
    /// DB columns: Year, Plan, CoId, Description, Dept, DeptDescription, DeptType,
    ///             Month, DispOrder, ColName, FldVal
    ///
    /// NO ROUNDING: every value is the raw string SQL Server sent back ("" for NULL).
    /// FldVal stays as the DB has it, e.g. "0.00000" or "241.97590".
    ///
    /// Usage:
    ///   LegacyContractManhoursDb.ConnectionString = "...";   // set once in test setup
    ///   var rows = LegacyContractManhoursDb.GetDeptMonths(query, "600");
    ///   rows[0]["Month"]    // "1"
    ///   rows[0]["ColName"]  // "ContractManhours_Jan"
    ///   rows[0]["FldVal"]   // "0.00000"
    /// </summary>
    public static class LegacyContractManhoursDb
    {
        /// <summary>Set once during test setup (same pattern as SqlProcRunner.ConnectionString).</summary>
        public static string ConnectionString { get; set; }

        public const string DeptColumn  = "Dept";
        public const string MonthColumn = "Month";

        /// <summary>
        /// Every row the query returns, each as column name -> raw string.
        /// Pass parameters only if your query uses them (e.g. "@PlanId").
        /// </summary>
        public static List<Dictionary<string, string>> RunQuery(
            string query,
            IDictionary<string, object> parameters = null,
            int timeoutSeconds = 120)
        {
            if (string.IsNullOrWhiteSpace(ConnectionString))
                throw new InvalidOperationException(
                    "LegacyContractManhoursDb.ConnectionString is not set.");
            if (string.IsNullOrWhiteSpace(query))
                throw new ArgumentException("Query is required.", nameof(query));

            var rows = new List<Dictionary<string, string>>();

            using var conn = new SqlConnection(ConnectionString);
            using var cmd = new SqlCommand(query, conn)
            {
                CommandType = CommandType.Text,
                CommandTimeout = timeoutSeconds
            };

            if (parameters != null)
            {
                foreach (var p in parameters)
                {
                    string name = p.Key.StartsWith("@") ? p.Key : "@" + p.Key;
                    cmd.Parameters.AddWithValue(name, p.Value ?? DBNull.Value);
                }
            }

            conn.Open();
            using var reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                for (int i = 0; i < reader.FieldCount; i++)
                    row[reader.GetName(i)] = RawText(reader.GetValue(i));
                rows.Add(row);
            }

            return rows;
        }

        /// <summary>
        /// The 12 rows for one dept, sorted by Month (1 = Jan .. 12 = Dec).
        /// Throws if the dept isn't in the results. Warns if there aren't exactly 12 rows.
        /// </summary>
        public static List<Dictionary<string, string>> GetDeptMonths(
            string query,
            string dept,
            IDictionary<string, object> parameters = null)
        {
            if (string.IsNullOrWhiteSpace(dept))
                throw new ArgumentException("Department number is required.", nameof(dept));

            dept = dept.Trim();
            var all = RunQuery(query, parameters);

            var rows = all
                .Where(r => r.TryGetValue(DeptColumn, out var v) && SameNumber(dept, v))
                .OrderBy(r => MonthNumber(r))
                .ToList();

            if (rows.Count == 0)
                throw new KeyNotFoundException(
                    $"Dept '{dept}' not found in the query results ({all.Count} rows returned).");

            if (rows.Count != 12)
                Console.WriteLine($"Warning: Dept '{dept}' returned {rows.Count} rows, expected 12.");

            return rows;
        }

        /// <summary>
        /// Turns the 12 DB rows into one row keyed by the Excel headers, so it lines up
        /// with LegacyContractManhoursExcel.QueryByDept:
        ///   Year, Plan, CoId, Description           -> same DB columns (from the first row)
        ///   Dept#                                   -> Dept
        ///   DeptDescription                         -> DeptDescription
        ///   Category                                -> DeptType
        ///   ContractManhours_Jan .. _Dec            -> FldVal of the row whose ColName matches
        /// Values are copied as-is.
        /// </summary>
        public static Dictionary<string, string> ToExcelRow(List<Dictionary<string, string>> deptRows)
        {
            if (deptRows == null || deptRows.Count == 0)
                throw new ArgumentException("No DB rows to convert.", nameof(deptRows));

            var first = deptRows[0];
            string Get(Dictionary<string, string> r, string col) => r.TryGetValue(col, out var v) ? v : "";

            var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["Year"]            = Get(first, "Year"),
                ["Plan"]            = Get(first, "Plan"),
                ["CoId"]            = Get(first, "CoId"),
                ["Description"]     = Get(first, "Description"),
                ["Dept#"]           = Get(first, "Dept"),
                ["DeptDescription"] = Get(first, "DeptDescription"),
                ["Category"]        = Get(first, "DeptType"),
            };

            foreach (var r in deptRows)
            {
                string colName = Get(r, "ColName").Trim();
                if (colName.Length == 0)
                {
                    // Fall back to the Month number if ColName is blank
                    int m = MonthNumber(r);
                    if (m < 1 || m > 12) continue;
                    colName = "ContractManhours_" + LegacyContractManhoursExcel.MonthNames[m - 1];
                }
                result[colName] = Get(r, "FldVal");
            }

            return result;
        }

        private static int MonthNumber(Dictionary<string, string> row) =>
            row.TryGetValue(MonthColumn, out var v) &&
            int.TryParse(v, NumberStyles.Integer, CultureInfo.InvariantCulture, out var m) ? m : int.MaxValue;

        private static bool SameNumber(string a, string b)
        {
            b = (b ?? "").Trim();
            if (a.Equals(b, StringComparison.OrdinalIgnoreCase)) return true;
            return decimal.TryParse(a, NumberStyles.Number, CultureInfo.InvariantCulture, out var x)
                && decimal.TryParse(b, NumberStyles.Number, CultureInfo.InvariantCulture, out var y)
                && x == y;
        }

        /// <summary>The DB value as text, with no rounding. NULL becomes "".</summary>
        private static string RawText(object value)
        {
            if (value == null || value == DBNull.Value) return "";
            switch (value)
            {
                case decimal m:   return m.ToString(CultureInfo.InvariantCulture);   // keeps "0.00000"
                case double d:    return d.ToString("R", CultureInfo.InvariantCulture);
                case float f:     return f.ToString("R", CultureInfo.InvariantCulture);
                case DateTime dt: return dt.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                default:          return Convert.ToString(value, CultureInfo.InvariantCulture);
            }
        }
    }
}
