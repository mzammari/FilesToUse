using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;

namespace ISAS.Automation
{
    /// <summary>
    /// Parses an Excel file (.xls or .xlsx) into a nested dictionary.
    /// 
    /// Usage:
    ///   var metrics = ExcelParser.ToList("Employed (Productive) FTEs:, Contract FTEs, Total Productive FTEs");
    ///   var columns = ExcelParser.ToList("Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Oct, Nov, Dec, Total");
    ///   
    ///   var report = ExcelParser.ParseExcel("Report.xls", metrics, columns);
    ///   
    ///   double jan = report["Employed (Productive) FTEs:"]["Jan"];
    ///   double total = report["Contract FTEs"]["Total"];
    /// </summary>
    public class ExcelParser
    {
        // Month names used to detect header rows
        private static readonly HashSet<string> MonthNames = new(StringComparer.OrdinalIgnoreCase)
        {
            "Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Total"
        };

        /// <summary>
        /// Auto-discover everything: finds header rows (the "blue" rows with Jan-Dec-Total),
        /// extracts column names, and grabs all metric rows automatically.
        /// No need to pass metrics or columns — it discovers them from the file.
        /// 
        /// Returns (columns, metrics, data):
        ///   columns = List of column names found (e.g., Jan, Feb... Total)
        ///   metrics = List of all metric names found
        ///   data    = Dictionary&lt;metricName, Dictionary&lt;columnName, value&gt;&gt;
        /// 
        /// Usage:
        ///   var (columns, metrics, data) = ExcelParser.AutoDiscover("Report.xls");
        ///   double jan = data["Employed (Productive) FTEs:"]["Jan"];
        /// </summary>
        public static (List<string> Columns, List<string> Metrics, Dictionary<string, Dictionary<string, double>> Data)
            AutoDiscover(string fileLocation, string sheetName = null)
        {
            var table = ExcelHeaderDiscovery.ReadSheet(fileLocation, sheetName);

            // Step 1: Find all header rows (rows containing month names like Jan, Feb...)
            var headerRows = new List<int>();
            var discoveredColumns = new List<string>();

            for (int row = 0; row < table.Rows.Count; row++)
            {
                int monthCount = 0;
                for (int col = 0; col < table.Columns.Count; col++)
                {
                    string val = table.Rows[row][col]?.ToString()?.Trim();
                    if (!string.IsNullOrEmpty(val) && MonthNames.Contains(val))
                        monthCount++;
                }

                // A row with 3+ month names is a header row
                if (monthCount >= 3)
                {
                    headerRows.Add(row);

                    // Extract column names (only from the first header row to avoid duplicates)
                    if (discoveredColumns.Count == 0)
                    {
                        for (int col = 0; col < table.Columns.Count; col++)
                        {
                            string val = table.Rows[row][col]?.ToString()?.Trim();
                            if (!string.IsNullOrEmpty(val))
                                discoveredColumns.Add(val);
                        }
                    }
                }
            }

            if (headerRows.Count == 0)
                throw new Exception("No header rows found. Expected rows containing Jan, Feb, Mar... Total.");

            // Step 2: Find the key column (first column with metric names — typically col 0 or 1)
            int keyCol = FindMetricKeyColumn(table, headerRows);

            // Step 3: Map column names to their DataTable positions (from first header row)
            var columnMap = new List<(string Name, int ColIndex)>();
            int firstHeaderRow = headerRows[0];
            for (int col = 0; col < table.Columns.Count; col++)
            {
                string val = table.Rows[firstHeaderRow][col]?.ToString()?.Trim();
                if (!string.IsNullOrEmpty(val) && col != keyCol)
                    columnMap.Add((val, col));
            }

            // Step 4: Extract all metric rows (rows between header rows that have data in the key column)
            var headerRowSet = new HashSet<int>(headerRows);
            var allMetrics = new List<string>();
            var data = new Dictionary<string, Dictionary<string, double>>(StringComparer.OrdinalIgnoreCase);

            for (int row = 0; row < table.Rows.Count; row++)
            {
                // Skip header rows themselves
                if (headerRowSet.Contains(row))
                    continue;

                string metricName = table.Rows[row][keyCol]?.ToString()?.Trim();
                if (string.IsNullOrWhiteSpace(metricName))
                    continue;

                // Skip section title rows (rows that appear right before a header row)
                bool isSectionTitle = headerRowSet.Contains(row + 1) || headerRowSet.Contains(row + 2);
                
                // Also skip rows that have text only in the key column and nothing in data columns
                bool hasData = false;
                foreach (var (_, colIndex) in columnMap)
                {
                    var cellObj = table.Rows[row][colIndex];
                    if (cellObj != null && cellObj != DBNull.Value && cellObj.ToString()?.Trim() != "")
                    {
                        hasData = true;
                        break;
                    }
                }

                if (!hasData)
                    continue;

                // This is a metric row — extract it
                var rowData = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
                foreach (var (name, colIndex) in columnMap)
                {
                    object cellObj = table.Rows[row][colIndex];
                    rowData[name] = ConvertToDouble(cellObj);
                }

                // Handle duplicate metric names across sections
                string uniqueKey = metricName;
                if (data.ContainsKey(uniqueKey))
                {
                    int suffix = 2;
                    while (data.ContainsKey($"{metricName}_{suffix}"))
                        suffix++;
                    uniqueKey = $"{metricName}_{suffix}";
                }

                data[uniqueKey] = rowData;
                allMetrics.Add(uniqueKey);
            }

            Console.WriteLine($"Auto-discovered: {discoveredColumns.Count} columns, {allMetrics.Count} metrics across {headerRows.Count} sections");

            return (discoveredColumns, allMetrics, data);
        }

        /// <summary>
        /// Find the column that contains metric names (first column with text in data rows).
        /// </summary>
        private static int FindMetricKeyColumn(DataTable table, List<int> headerRows)
        {
            foreach (int headerRow in headerRows)
            {
                for (int row = headerRow + 1; row < Math.Min(headerRow + 5, table.Rows.Count); row++)
                {
                    for (int col = 0; col < Math.Min(table.Columns.Count, 3); col++)
                    {
                        string val = table.Rows[row][col]?.ToString()?.Trim();
                        if (!string.IsNullOrEmpty(val) && !MonthNames.Contains(val))
                            return col;
                    }
                }
            }
            return 0;
        }

        /// <summary>
        /// Parse Excel (.xls or .xlsx) into Dictionary&lt;metricName, Dictionary&lt;columnName, value&gt;&gt;.
        /// </summary>
        public static Dictionary<string, Dictionary<string, double>> ParseExcel(
            string fileLocation,
            List<string> metrics,
            List<string> columns,
            string dataType = "double",
            string sheetName = null,
            int headerRow = 0)
        {
            // Read the sheet into a DataTable (works for .xls and .xlsx)
            var table = ExcelHeaderDiscovery.ReadSheet(fileLocation, sheetName);

            // Discover headers and their positions
            var headers = ExcelHeaderDiscovery.GetHeaders(table, headerRow);
            int detectedHeaderRow = headers.Values.FirstOrDefault()?.HeaderRow ?? 0;

            // Find the key column (where metric names live)
            int keyColIndex = FindKeyColumn(table, detectedHeaderRow, metrics);

            // Map requested columns to their DataTable positions
            var columnMap = new List<(string Name, int ColIndex)>();
            foreach (var col in columns)
            {
                var colInfo = headers.Values.FirstOrDefault(h =>
                    h.HeaderName.Equals(col, StringComparison.OrdinalIgnoreCase));

                if (colInfo != null)
                    columnMap.Add((col, colInfo.ColumnIndex));
                else
                    Console.WriteLine($"Warning: Column '{col}' not found in Excel.");
            }

            // Build the result
            var result = new Dictionary<string, Dictionary<string, double>>(StringComparer.OrdinalIgnoreCase);

            // Scan rows and match metrics
            var remaining = new HashSet<string>(metrics, StringComparer.OrdinalIgnoreCase);

            for (int row = detectedHeaderRow + 1; row < table.Rows.Count && remaining.Count > 0; row++)
            {
                string cellValue = table.Rows[row][keyColIndex]?.ToString()?.Trim();
                if (cellValue == null || !remaining.Contains(cellValue))
                    continue;

                var rowData = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);

                foreach (var (name, colIndex) in columnMap)
                {
                    object cellObj = table.Rows[row][colIndex];
                    rowData[name] = ConvertToDouble(cellObj);
                }

                result[cellValue] = rowData;
                remaining.Remove(cellValue);
            }

            if (remaining.Count > 0)
                Console.WriteLine($"Warning: Metrics not found: {string.Join(", ", remaining)}");

            return result;
        }

        /// <summary>
        /// Parse a DB query result file where months are rows and metrics are columns.
        /// Returns Dictionary&lt;monthName, Dictionary&lt;fieldName, value&gt;&gt;.
        /// 
        /// DB result structure:
        ///   MonthNum | MonthName | EmployedProductiveFtes | ContractPercent | ...
        ///   1        | Jan       | 26343.89              | 0               | ...
        ///   2        | Feb       | 29908.93              | 0               | ...
        /// 
        /// Usage:
        ///   var fields = ExcelParser.ToList("EmployedProductiveFtes, ContractPercent, ContractFTEs");
        ///   var dbData = ExcelParser.ParseDbResult("LaborMonthlySummary.xlsx", fields, "MonthName");
        ///   double jan = dbData["Jan"]["EmployedProductiveFtes"];  // 26343.89
        /// </summary>
        public static Dictionary<string, Dictionary<string, double>> ParseDbResult(
            string fileLocation,
            List<string> fields,
            string monthColumn = "MonthName",
            string sheetName = null)
        {
            var table = ExcelHeaderDiscovery.ReadSheet(fileLocation, sheetName);
            var headers = ExcelHeaderDiscovery.GetHeaders(table);
            int headerRow = headers.Values.FirstOrDefault()?.HeaderRow ?? 0;

            // Find the month column
            var monthCol = headers.Values.FirstOrDefault(h =>
                h.HeaderName.Equals(monthColumn, StringComparison.OrdinalIgnoreCase));

            if (monthCol == null)
                throw new KeyNotFoundException($"Month column '{monthColumn}' not found. " +
                    $"Available: {string.Join(", ", headers.Values.Select(h => h.HeaderName))}");

            // Map requested fields to their DataTable positions
            var fieldMap = new List<(string Name, int ColIndex)>();
            foreach (var field in fields)
            {
                var colInfo = headers.Values.FirstOrDefault(h =>
                    h.HeaderName.Equals(field, StringComparison.OrdinalIgnoreCase));

                if (colInfo != null)
                    fieldMap.Add((field, colInfo.ColumnIndex));
                else
                    Console.WriteLine($"Warning: Field '{field}' not found in DB result.");
            }

            // Build result: month -> field -> value
            var result = new Dictionary<string, Dictionary<string, double>>(StringComparer.OrdinalIgnoreCase);

            for (int row = headerRow + 1; row < table.Rows.Count; row++)
            {
                string month = table.Rows[row][monthCol.ColumnIndex]?.ToString()?.Trim();
                if (string.IsNullOrWhiteSpace(month)) continue;

                var rowData = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
                foreach (var (name, colIndex) in fieldMap)
                {
                    object cellObj = table.Rows[row][colIndex];
                    rowData[name] = ConvertToDouble(cellObj);
                }

                result[month] = rowData;
            }

            return result;
        }

        /// <summary>
        /// Compare Excel values against DB values.
        /// Returns a list of results with pass/fail.
        /// </summary>
        public static List<CompareResult> Compare(
            Dictionary<string, Dictionary<string, double>> excelData,
            Dictionary<string, Dictionary<string, double>> dbData,
            double tolerance = 0.01)
        {
            var results = new List<CompareResult>();

            foreach (var metric in excelData)
            {
                if (!dbData.TryGetValue(metric.Key, out var dbRow))
                {
                    results.Add(new CompareResult
                    {
                        Metric = metric.Key,
                        Column = "*",
                        ExcelValue = 0,
                        DbValue = 0,
                        Match = false,
                        Note = "Metric not found in DB"
                    });
                    continue;
                }

                foreach (var col in metric.Value)
                {
                    double dbVal = dbRow.TryGetValue(col.Key, out var v) ? v : 0;
                    bool match = Math.Abs(col.Value - dbVal) <= tolerance;

                    results.Add(new CompareResult
                    {
                        Metric = metric.Key,
                        Column = col.Key,
                        ExcelValue = col.Value,
                        DbValue = dbVal,
                        Match = match
                    });
                }
            }

            return results;
        }

        /// <summary>
        /// Print comparison results. Shows all or only mismatches.
        /// </summary>
        public static void PrintCompareResults(List<CompareResult> results, bool onlyMismatches = false)
        {
            var filtered = onlyMismatches ? results.Where(r => !r.Match).ToList() : results;

            Console.WriteLine($"\n{"Metric",-40} {"Column",-8} {"Excel",>12} {"DB",>12} {"Match",>8}");
            Console.WriteLine(new string('-', 82));

            foreach (var r in filtered)
            {
                Console.WriteLine($"{r.Metric,-40} {r.Column,-8} {r.ExcelValue,12:F4} {r.DbValue,12:F4} {(r.Match ? "PASS" : "FAIL"),>8}");
            }

            int total = results.Count;
            int passed = results.Count(r => r.Match);
            Console.WriteLine(new string('-', 82));
            Console.WriteLine($"Total: {total} | Passed: {passed} | Failed: {total - passed}");
        }

        /// <summary>
        /// Convert comma-delimited string to List&lt;string&gt;.
        /// </summary>
        public static List<string> ToList(string commaDelimited)
        {
            return commaDelimited
                .Split(',')
                .Select(s => s.Trim())
                .Where(s => !string.IsNullOrEmpty(s))
                .ToList();
        }

        private static double ConvertToDouble(object cellObj)
        {
            if (cellObj == null || cellObj == DBNull.Value)
                return 0.0;

            // Already a number type
            if (cellObj is double d) return d;
            if (cellObj is decimal dec) return (double)dec;
            if (cellObj is int i) return i;
            if (cellObj is long l) return l;
            if (cellObj is float f) return f;

            // It's a string — parse it
            string text = cellObj.ToString()?.Trim();
            if (string.IsNullOrWhiteSpace(text)) return 0.0;

            // Percentage string: "52%", "4.21%"
            if (text.EndsWith("%"))
            {
                string numPart = text.TrimEnd('%').Trim();
                if (double.TryParse(numPart, out double pctValue))
                    return pctValue / 100.0;
            }

            // Currency/formatted: "$1,234.56"
            string cleaned = text.Replace("$", "").Replace(",", "").Trim();
            if (double.TryParse(cleaned, out double parsed))
                return parsed;

            return 0.0;
        }

        private static int FindKeyColumn(DataTable table, int headerRow, List<string> metrics)
        {
            var metricSet = new HashSet<string>(metrics, StringComparer.OrdinalIgnoreCase);
            int maxCol = Math.Min(table.Columns.Count, 5);

            for (int col = 0; col < maxCol; col++)
            {
                for (int row = headerRow + 1; row < table.Rows.Count; row++)
                {
                    string val = table.Rows[row][col]?.ToString()?.Trim();
                    if (val != null && metricSet.Contains(val))
                        return col;
                }
            }

            return 0;
        }
    }

    public class CompareResult
    {
        public string Metric { get; set; }
        public string Column { get; set; }
        public double ExcelValue { get; set; }
        public double DbValue { get; set; }
        public bool Match { get; set; }
        public string Note { get; set; }

        public override string ToString()
            => $"{Metric} | {Column}: Excel={ExcelValue:F4}, DB={DbValue:F4} -> {(Match ? "PASS" : "FAIL")}";
    }
}
